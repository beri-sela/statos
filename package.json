{
  "name": "statos",
  "private": true,
  "version": "0.1.3",
  "description": "Statos (Staff and Tonic Sol-fa): a browser editor for writing tonic sol-fa and converting it to and from staff notation.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b --noEmit",
    "build:offline": "vite build --mode offline"
  },
  "dependencies": {
    "opensheetmusicdisplay": "^1.8.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-singlefile": "^2.0.3",
    "vitest": "^2.1.8"
  }
}
